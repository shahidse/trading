# ---- Hardhat deployment (optional layer) ----
# RPC endpoint for Sepolia; leave blank to keep only the in-process network.
SEPOLIA_RPC_URL=
# Deployer key. Never commit a real key.
PRIVATE_KEY=

# Chainlink ETH/USD aggregator proxy (Ethereum mainnet default)
CHAINLINK_ETH_USD_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
