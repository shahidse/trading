{
  "name": "eth-signal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "analyze": "tsx scripts/analyze-once.ts",
    "backtest": "tsx scripts/backtest.ts",
    "check-oracle": "tsx scripts/check-oracle.ts",
    "check-telegram": "tsx scripts/check-telegram.ts",
    "check-exchange": "tsx scripts/check-exchange.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "contracts:install": "npm --prefix contracts install",
    "contracts:test": "npm --prefix contracts test",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "better-sqlite3": "^11.5.0",
    "ccxt": "^4.4.48",
    "drizzle-orm": "^0.36.4",
    "lightweight-charts": "^4.2.1",
    "next": "^15.1.0",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "technicalindicators": "^3.1.0",
    "viem": "^2.21.45",
    "wagmi": "^2.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
