# ==============================================================================
# Binance API Credentials
# Required for automated trading (Live or Testnet).
# Withdrawals must be DISABLED on the API key.
# ==============================================================================
BINANCE_API_KEY=
BINANCE_SECRET=

# ==============================================================================
# Execution Environment Switches
# ==============================================================================
# Set BINANCE_TESTNET=true for Binance Spot Testnet (fake funds), false for live trading
BINANCE_TESTNET=true
# Master switch to arm automated order execution (true / false)
AUTO_TRADE_ENABLED=false
# Set DRY_RUN=true to simulate orders in logs, false to send real orders to Binance
DRY_RUN=false
# Immediate circuit breaker — set true to freeze all new orders
TRADING_KILL_SWITCH=false

# ==============================================================================
# Risk & Order Limits (Stateless Deployment Persistence)
# Checked before every order placement without depending on local disk database.
# ==============================================================================
# Order size in USD per entry
TRADE_NOTIONAL_USD=100
# Hard cap — rejects any single order exceeding this amount
MAX_NOTIONAL_USD=250
# Rolling 24h realised loss limit in USD — pauses trading if breached
DAILY_LOSS_LIMIT_USD=50
# Max executed buy trades allowed per coin in a rolling 24h window
MAX_DAILY_TRADES=5
# Attach native Binance One-Cancels-the-Other (Take Profit + Stop Loss) bracket
USE_OCO_BRACKET=true

# ==============================================================================
# Strategy & Multi-Coin Configuration
# ==============================================================================
# Reversal scalping mode: capture oversold bounces and candle patterns
REVERSAL_SCALP_MODE=true
# Multi-coin scanner / scheduler symbols (comma-separated, ETH is default)
SYMBOLS=
# Candle interval timeframe (default 15m)
CANDLE_INTERVAL=15m

# ==============================================================================
# Ethereum RPC & Chainlink Price Oracle (Optional)
# Verifies ETH spot price divergence against on-chain Chainlink feed.
# Verify with: npm run check-oracle
# ==============================================================================
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
CHAINLINK_ETH_USD_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# ==============================================================================
# Telegram Notifications (Optional)
# Get bot token from @BotFather. Verify with: npm run check-telegram
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notification trigger: action-change (default) | direction-change | every
TELEGRAM_NOTIFY_MODE=

# ==============================================================================
# Resend Email Alerts (Optional)
# Free API key from https://resend.com
# ==============================================================================
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Notification trigger: action-change (default) | direction-change | every
EMAIL_NOTIFY_MODE=

# ==============================================================================
# Persistence & Web3 (Optional)
# ==============================================================================
DATABASE_URL=file:./data/signals.db
# WalletConnect Project ID from https://cloud.reown.com (optional)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
