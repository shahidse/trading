# ---- Binance market data (public endpoints need no keys) ----
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_SYMBOL=ETH/USDT
CANDLE_INTERVAL=15m

# ---- Automatic trading (OPTIONAL — off by default) ----
# Requires a key with Spot Trading enabled and Withdrawals DISABLED.
# Verify with: npm run check-exchange
# TRADING_ENABLED=false        # master arm switch
# TRADING_KILL_SWITCH=false    # immediate halt, checked before every order
# TRADING_DRY_RUN=true         # log the order instead of sending it
# EXCHANGE_TESTNET=true        # Binance Spot Testnet (fake funds)
# TRADE_NOTIONAL_USD=100       # size per entry
# MAX_NOTIONAL_USD=100         # hard cap per order
# DAILY_LOSS_LIMIT_USD=50      # rolling 24h realised-loss limit

# ---- Ethereum RPC (for reading the Chainlink ETH/USD price feed) ----
# Verify with: npm run check-oracle
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Chainlink ETH/USD aggregator proxy on Ethereum mainnet
CHAINLINK_ETH_USD_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# ---- Web3 WalletConnect (Optional — fallback is enabled) ----
# Get a free Project ID from https://cloud.reown.com to customize mobile QR code branding
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Resend email alerts ----
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev
ALERT_EMAIL_TO=
# Trigger: action-change (default) | direction-change | every
EMAIL_NOTIFY_MODE=action-change

# ---- Telegram alerts ----
# Create a bot with @BotFather, message it, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates   Verify with: npm run check-telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Trigger: action-change (default) | direction-change | every
TELEGRAM_NOTIFY_MODE=action-change

# ---- Signal tuning ----
# ±35 produces almost no signals; ±25 is the empirically tuned default.
LONG_THRESHOLD=25
SHORT_THRESHOLD=-25
# CRON_SCHEDULE=*/15 * * * *

# ---- Persistence ----
DATABASE_URL=file:./data/signals.db
